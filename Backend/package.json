{
  "name": "coopers-barbershop-backend",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "//lint": "runs ESLint across all packages via Turborepo to catch code quality issues",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "//format": "auto-formats all ts, js, json, md, and yaml files in place using Prettier",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "//format:check": "checks for unformatted code and returns a non-zero exit code — used in CI",
    "pre": "turbo run build",
    "booking:api": "turbo dev --filter @coopers/booking.api",
    "booking:guard": "turbo dev --filter @coopers/booking.guard",
    "auth:api": "turbo dev --filter @coopers/auth.api"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.6.1"
  }
}
