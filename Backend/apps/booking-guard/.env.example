ENV=develop

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=booking_user
DB_PASSWORD=replace-with-local-db-password
DB_DATABASE=booking_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SYNCHRONIZE=false

JWT_SECRET=replace-with-strong-local-jwt-secret
INTERNAL_GATEWAY_SECRET=replace-with-shared-local-gateway-secret

ACCESS_TOKEN_TTL_SECONDS=120
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_DOMAIN=
TRUST_PROXY=0

API_PORT=7310
AUTH_API_PORT=7312
GUARD_PORT=7311
FRONTEND_URL=http://localhost:5173
FRONTEND_DEV_URL=http://127.0.0.1:5173
ADMIN_FRONTEND_URL=http://localhost:5174,http://127.0.0.1:5174
ADMIN_FRONTEND_DEV_URL=http://127.0.0.1:5174
BOOKING_API_URL=http://localhost:7310
AUTH_API_URL=http://localhost:7312
ADMIN_API_URL=http://localhost:7313

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_TTL_SECONDS=60
LOGIN_RATE_LIMIT_MAX_REQUESTS=20

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:7311/auth/google/callback
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:7311/appointments
OAUTH_FAILURE_REDIRECT_URL=http://localhost:7311/
