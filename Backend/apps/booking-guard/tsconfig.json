{
  "extends": "@coopers/tsconfig/nestjs.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@coopers/common": ["../../packages/common/dist/index.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
