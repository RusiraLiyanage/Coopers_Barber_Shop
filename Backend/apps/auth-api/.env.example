ENV=develop

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=booking_user
DB_PASSWORD=replace-with-local-db-password
DB_DATABASE=booking_db

JWT_SECRET=replace-with-strong-local-jwt-secret
INTERNAL_GATEWAY_SECRET=replace-with-shared-local-gateway-secret

ACCESS_TOKEN_TTL_SECONDS=120
REFRESH_TOKEN_TTL_DAYS=14
SESSION_IDLE_TIMEOUT_SECONDS=300
SESSION_EXTENSION_GRACE_SECONDS=300
SESSION_CLEANUP_INTERVAL_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

API_PORT=7310
AUTH_API_PORT=7312
GUARD_PORT=7311
FRONTEND_URL=http://localhost:5173
BOOKING_API_URL=http://localhost:7310
AUTH_API_URL=http://localhost:7312
ADMIN_API_URL=http://localhost:7313

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=Cooper's Barbershop <password-reset@example.com>
APP_NAME=Cooper's Barbershop
