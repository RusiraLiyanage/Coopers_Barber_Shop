ENV=develop

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=booking_user
DB_PASSWORD=replace-with-local-db-password
DB_DATABASE=booking_db

JWT_SECRET=replace-with-strong-local-jwt-secret
INTERNAL_GATEWAY_SECRET=replace-with-shared-local-gateway-secret

ANTHROPIC_API_KEY=replace-with-server-side-anthropic-key
ANTHROPIC_MODEL=claude-haiku-4-5

REDIS_CACHE_ENABLED=true
REDIS_CACHE_DEFAULT_TTL_SECONDS=300
REDIS_PRIMARY_HOST=localhost
REDIS_PRIMARY_PORT=6379
REDIS_PRIMARY_USERNAME=
REDIS_PRIMARY_PASSWORD=
REDIS_PRIMARY_TLS_ENABLED=false
REDIS_READER_HOST=localhost
REDIS_READER_PORT=6379
REDIS_READER_USERNAME=
REDIS_READER_PASSWORD=
REDIS_READER_TLS_ENABLED=false

IDEMPOTENCY_KEY_TTL_SECONDS=86400

API_PORT=7310
AUTH_API_PORT=7312
GUARD_PORT=7311
FRONTEND_URL=http://localhost:5173
BOOKING_API_URL=http://localhost:7310
AUTH_API_URL=http://localhost:7312
